    {
      "name": "03. Ventas - Registrar Venta Exitosa (201)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clienteId\": 1,\n  \"detalles\": [\n    {\n      \"productoId\": 1,\n      \"cantidad\": 1\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/ventas",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "ventas"]
        }
      }
    },
    {
      "name": "04. Ventas - Venta sin Productos (400)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clienteId\": 1,\n  \"detalles\": []\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/ventas",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "ventas"]
        }
      }
    },
    {
      "name": "05. Ventas - Stock Insuficiente (409)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clienteId\": 1,\n  \"detalles\": [\n    {\n      \"productoId\": 1,\n      \"cantidad\": 999999\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/ventas",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "ventas"]
        }
      }
    },
    {
      "name": "06. Productos - Buscar por ID No Existente (404)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/productos/999999",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "productos", "999999"]
        }
