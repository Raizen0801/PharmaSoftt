    {
      "name": "07. Auditoría - Listar Bitácora Paginada como Admin (200)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auditoria?page=0&size=10&ordenarPor=fecha&direccion=desc",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auditoria"],
          "query": [
            { "key": "page", "value": "0" },
            { "key": "size", "value": "10" },
            { "key": "ordenarPor", "value": "fecha" },
            { "key": "direccion", "value": "desc" }
          ]
        }
      }
    },
    {
      "name": "08. Auditoría - Acceso Denegado con Rol Vendedor (403)",
      "request": {
        "method": "GET",
        "header": [
